# Copy this file to .env and fill in what you need. `npm run server` and `npm start` read .env automatically.

# Who can review and publish events (comma-separated emails).
ADMIN_EMAILS=tester@comoonly.test

# AI that reads event posts and posters ("Suggest an event", and pages without structured data).
# Recommended: Google Gemini, free tier, reads images too.
#   1. Go to aistudio.google.com, sign in, click "Get API key", create a key.
#   2. Paste it as AI_API_KEY below.
#   3. Set AI_MODEL to the current "Flash" model listed in AI Studio (for example gemini-2.5-flash).
# On the free tier Google may use what you send to improve its models: fine for public event posts.
# Other options: Groq (https://api.groq.com/openai/v1, text only) or Ollama on your laptop (http://localhost:11434/v1).
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=

# Instagram reader (official API). Leave empty until Meta approves your app; see README "Instagram reader".
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=

# The server looks for new events every 12 hours in production. Set to 1 to also do it on your computer.
# AUTO_FIND=1

# Production only: where the database file lives (point it at your host's persistent disk).
# DB_PATH=/var/data/comoonly.db

# Local test account in the local database only (made while testing; not a real person):
#   tester@comoonly.test / testpass123
#   tester2@comoonly.test / testpass123   (second account, for trying connections and notifications)
