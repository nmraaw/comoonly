{
  "name": "comoonly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env --watch server/src/index.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/src/index.ts",
    "live": "npm run build && caffeinate -is npm start",
    "test": "node --test \"server/test/*.test.ts\"",
    "test:libsql": "DB_DRIVER=libsql node --test \"server/test/*.test.ts\"",
    "test:turso": "node --env-file=.env.turso-check.local --test server/test/database.test.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "libsql": "^0.5.29",
    "nodemailer": "^10.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
